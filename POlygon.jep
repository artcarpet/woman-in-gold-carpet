# index.html

```html
<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Woman in Gold Carpet</title>

<style>

.logo{
    position:fixed;
    top:30px;
    left:35px;
    color:#d4af37;
    font-family:Georgia, serif;
    font-size:28px;
    font-weight:bold;
    letter-spacing:2px;
    text-align:left;
    z-index:1000;
}

.logo span{
    display:block;
    font-size:13px;
    color:#ffffff;
    letter-spacing:3px;
    margin-top:5px;
    font-weight:normal;
}

body{
    margin:0;
    background:#111;
    color:white;
    font-family:Arial, Helvetica, sans-serif;
    text-align:center;
}

/* Main title area */

.page-title{
    max-width:900px;
    margin:35px auto 25px;
    padding:0 20px;
    text-align:center;
}

.page-title h1{
    font-size:52px;
    color:#d4af37;
    margin:0 0 20px;
}

/* Polygon image */

.polygon-image{
    display:block;
    width:300px;
    height:300px;
    object-fit:cover;
    margin:0 auto 25px;
    border-radius:18px;
}

.page-title .subtitle{
    font-size:24px;
    color:#ffffff;
    margin-bottom:20px;
}

.page-title .event{
    font-size:18px;
    color:#ffffff;
    line-height:1.9;
    margin-bottom:30px;
}

.page-title .event em{
    font-style:italic;
}

/* Reveal video */

.hero-video{
    width:70%;
    max-width:900px;
    border-radius:18px;
    display:block;
    margin:40px auto;
}

/* Artist statement */

.about{
    max-width:700px;
    margin:50px auto;
    padding:0 20px;
}

.about h2{
    color:#d4af37;
    font-size:28px;
    margin-bottom:15px;
}

.about p{
    color:#d9d9d9;
    line-height:1.8;
    font-size:17px;
}

/* Interview videos */

.interview-video{
    width:70%;
    max-width:650px;
    border-radius:18px;
    display:block;
    margin:40px auto;
}

/* Footer */

footer{
    margin-top:70px;
    padding:35px 20px;
    border-top:1px solid #333;
    color:#888;
    font-size:14px;
    line-height:1.8;
}

footer p{
    margin:6px 0;
}

/* Mobile */

@media (max-width:600px){

    .logo{
        position:relative;
        top:auto;
        left:auto;
        margin:25px 0 10px;
        text-align:center;
    }

    .page-title h1{
        font-size:38px;
    }

    .page-title .subtitle{
        font-size:20px;
    }

    .page-title .event{
        font-size:16px;
    }

    .polygon-image{
        width:240px;
        height:240px;
    }

    .hero-video,
    .interview-video{
        width:90%;
    }
}

</style>
</head>


<body>

<!-- Logo -->

<div class="logo">
    ARTCarpet
    <span>Persian Fine Art</span>
</div>


<!-- Main title -->

<div class="page-title">

    <h1>Woman in Gold Carpet</h1>

    <!-- Polygon image -->

    <img
        class="polygon-image"
        src="polygon.jpg"
        alt="Polygon NFT"
    >

    <p class="subtitle">
        Official Website of the 1/1 NFT Artwork
    </p>

    <p class="event">
        This artistic masterpiece was officially unveiled by
        <em>the Ambassador of Austria to Iran</em>
        on January 23, 2018, at the
        <em>Parsian Hotel, Tehran</em>.
    </p>

</div>


<!-- Reveal video -->

<video class="hero-video" controls playsinline>
    <source src="reveal.mp4" type="video/mp4">
    Your browser does not support the video tag.
</video>


<!-- Artist Statement -->

<section class="about">

    <h2>Artist Statement</h2>

    <p>
        Woman in Gold Carpet is a unique 1/1 NFT artwork inspired by
        the timeless beauty of Persian carpet weaving. It combines
        cultural heritage with contemporary digital art and is
        permanently preserved on the Polygon blockchain.
    </p>

</section>


<!-- Ambassador interview -->

<video class="interview-video" controls playsinline>
    <source src="ambassador-interview.mp4" type="video/mp4">
    Your browser does not support the video tag.
</video>


<!-- Second interview -->

<video class="interview-video" controls playsinline>
    <source src="Interview2.mp4" type="video/mp4">
    Your browser does not support the video tag.
</video>


<!-- Footer -->

<footer>

    <p>© 2026 Woman in Gold Carpet</p>

    <p>All Rights Reserved</p>

    <p>Powered by Polygon Blockchain</p>

</footer>


</body>
</html>
```
